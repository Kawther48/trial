---
const { product, view = "front" } = Astro.props;
const color = product.colorHex;
const shade = product.shadowHex;
const trim = product.trimHex;
const label = `${product.name} hoodie, ${view} view`;
---

<svg
	class="hoodie-art"
	viewBox="0 0 300 340"
	role="img"
	aria-label={label}
	xmlns="http://www.w3.org/2000/svg"
>
	<defs>
		<linearGradient id={`fabric-${product.slug}`} x1="0" x2="1" y1="0" y2="1">
			<stop offset="0" stop-color={product.highlightHex} />
			<stop offset=".48" stop-color={color} />
			<stop offset="1" stop-color={shade} />
		</linearGradient>
		<linearGradient id={`sleeve-${product.slug}`} x1="0" x2="1" y1="0" y2=".2">
			<stop stop-color={color} />
			<stop offset="1" stop-color={shade} />
		</linearGradient>
	</defs>

	{view === "side" ? (
		<g stroke="#493d4b" stroke-linejoin="round" stroke-width="2.5">
			<path d="M111 83C99 67 103 43 122 31c18-12 42-7 54 7 9 10 11 25 7 43l-21 17-44-2z" fill={`url(#fabric-${product.slug})`} />
			<path d="M130 76c-1-18 6-30 20-37 12 6 19 18 18 36l-18 13z" fill={shade} />
			<path d="M119 88c-17-7-27 4-31 22l-5 172c0 14 8 22 22 22h76c13 0 21-8 21-22l-4-166c0-20-10-29-28-28l-19 19-16-1z" fill={`url(#fabric-${product.slug})`} />
			<path d="m93 112-30 21-24 70c-4 12 1 21 11 25l12 5 31-63z" fill={`url(#sleeve-${product.slug})`} />
			<path d="m207 112 27 21 22 69c4 12-1 21-11 25l-12 5-30-62z" fill={`url(#sleeve-${product.slug})`} />
			<path d="M54 227 78 235l-5 15-24-8zM222 235l24-8 5 15-24 8z" fill={shade} />
			<path d="M51 233q8-2 12 5l-3 7-11-3z" fill="#30283b" />
			<path d="M228 238q8-7 16-5l2 9-11 3z" fill="#30283b" />
			<path d="M106 296h82" fill="none" stroke={shade} stroke-width="8" />
			<path d="M101 105q-10 42-8 93M196 105q10 43 8 93" fill="none" opacity=".34" />
			<path d="M157 129v48m-8-43q8 7 16 0" fill="none" stroke={trim} stroke-linecap="round" stroke-width="3" />
			<path d="M155 188q15-9 27-2l-3 14q-12-5-24 4z" fill={trim} stroke="none" />
		</g>
	) : view === "back" ? (
		<g stroke="#493d4b" stroke-linejoin="round" stroke-width="2.5">
			<path d="M112 81c-2-29 12-51 38-54 26 3 40 25 38 54l-14 16h-48z" fill={`url(#fabric-${product.slug})`} />
			<path d="M129 72c2-17 9-28 21-33 12 5 19 16 21 33l-21 17z" fill={shade} />
			<path d="M112 83c-15 2-27 7-40 17l-32 27 24 79 24-9v106q0 11 12 11h100q12 0 12-11V197l24 9 24-79-32-27c-13-10-25-15-40-17l-18 14h-40z" fill={`url(#fabric-${product.slug})`} />
			<path d="m40 128-7 9 23 66 23-8-15-61zM260 128l7 9-23 66-23-8 15-61z" fill={`url(#sleeve-${product.slug})`} />
			<path d="M43 194 67 202l-8 18-23-8zM233 202l24-8 8 18-23 8z" fill={shade} />
			<ellipse cx="51" cy="208" rx="6" ry="3" transform="rotate(19 51 208)" fill="#30283b" />
			<ellipse cx="249" cy="208" rx="6" ry="3" transform="rotate(-19 249 208)" fill="#30283b" />
			<path d="M89 199q61 15 122 0M87 304h126" fill="none" stroke={shade} stroke-width="7" />
			<path d="M105 121q45 18 90 0" fill="none" stroke={shade} opacity=".7" />
			<path d="M128 155q22-23 44 0-22 24-44 0z" fill={trim} stroke="none" />
			<text x="150" y="160" fill="#493d4b" font-size="8" font-weight="700" letter-spacing="1.2" text-anchor="middle">{product.mark}</text>
		</g>
	) : view === "details" ? (
		<g>
			<rect x="14" y="19" width="272" height="302" rx="8" fill="#eee8df" />
			<text x="30" y="47" fill="#493d4b" font-size="10" font-weight="700" letter-spacing="1.5">MADE FOR COMFY HANDS</text>
			<path d="M76 83q74 22 148 0l-9 91q-65 24-130 0z" fill={`url(#fabric-${product.slug})`} stroke="#493d4b" stroke-width="2.5" stroke-linejoin="round" />
			<path d="M90 105q58 18 120 0" fill="none" stroke={shade} stroke-width="2" opacity=".7" />
			<path d="M89 109q61 18 122 0" fill="none" stroke="#fff" stroke-width="1" opacity=".45" />
			<text x="150" y="192" fill="#493d4b" font-size="9" font-weight="700" letter-spacing="1.3" text-anchor="middle">ROOMY KANGAROO POCKET</text>
			<path d="M48 241 100 228l13 51-52 14z" fill={`url(#sleeve-${product.slug})`} stroke="#493d4b" stroke-width="2.5" stroke-linejoin="round" />
			<path d="m57 274 48-13 6 17-49 14z" fill={shade} stroke="#493d4b" stroke-width="2" />
			<ellipse cx="92" cy="279" rx="7" ry="3.5" transform="rotate(-16 92 279)" fill="#30283b" />
			<path d="m187 228 52 13-13 52-52-14z" fill={`url(#sleeve-${product.slug})`} stroke="#493d4b" stroke-width="2.5" stroke-linejoin="round" />
			<path d="m191 261 48 13-5 18-49-14z" fill={shade} stroke="#493d4b" stroke-width="2" />
			<ellipse cx="207" cy="279" rx="7" ry="3.5" transform="rotate(16 207 279)" fill="#30283b" />
			<text x="150" y="311" fill="#493d4b" font-size="9" font-weight="700" letter-spacing="1.3" text-anchor="middle">THUMBHOLE CUFFS · BOTH SLEEVES</text>
		</g>
	) : (
		<g stroke="#493d4b" stroke-linejoin="round" stroke-width="2.5">
			<path d="M111 82c-2-27 12-51 39-54 27 3 41 27 39 54l-14 17h-50z" fill={`url(#fabric-${product.slug})`} />
			<path d="M128 72c2-18 9-29 22-34 13 5 20 16 22 34l-22 17z" fill={shade} />
			<path d="M112 84c-15 1-27 7-40 17l-32 27 24 79 24-9v106q0 11 12 11h100q12 0 12-11V198l24 9 24-79-32-27c-13-10-25-16-40-17l-18 14h-40z" fill={`url(#fabric-${product.slug})`} />
			<path d="m40 128-7 9 23 66 23-8-15-61zM260 128l7 9-23 66-23-8 15-61z" fill={`url(#sleeve-${product.slug})`} />
			<path d="M43 194 67 202l-8 18-23-8zM233 202l24-8 8 18-23 8z" fill={shade} />
			<ellipse cx="51" cy="208" rx="6" ry="3" transform="rotate(19 51 208)" fill="#30283b" />
			<ellipse cx="249" cy="208" rx="6" ry="3" transform="rotate(-19 249 208)" fill="#30283b" />
			<path d="M88 197q62 14 124 0l-8 54q-54 21-108 0z" fill={shade} stroke-width="2" />
			<path d="M96 204q54 12 108 0M150 91v153" fill="none" stroke="#fff" stroke-width="1.5" opacity=".35" />
			<path d="M44 195 67 203l-8 18-23-8zM233 203l23-8 8 18-23 8z" fill={shade} />
			<ellipse cx="52" cy="208" rx="6" ry="3" transform="rotate(19 52 208)" fill="#30283b" />
			<ellipse cx="248" cy="208" rx="6" ry="3" transform="rotate(-19 248 208)" fill="#30283b" />
			<path d="M89 303h122" fill="none" stroke={shade} stroke-width="8" />
			<path d="M101 111q-7 31-7 71M199 111q7 31 7 71" fill="none" stroke="#fff" opacity=".35" />
			<path d="M131 134q19-19 38 0-19 20-38 0z" fill={trim} stroke="none" />
			<text x="150" y="138" fill="#493d4b" font-size="8" font-weight="700" letter-spacing="1" text-anchor="middle">{product.mark}</text>
			<path d="M134 77q16 12 32 0" fill="none" stroke={trim} stroke-linecap="round" stroke-width="2" />
		</g>
	)}
</svg>

<style>
	.hoodie-art {
		display: block;
		width: 100%;
		height: 100%;
		overflow: visible;
	}
</style>
