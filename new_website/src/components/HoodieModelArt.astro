---
const { product, view = "front" } = Astro.props;
const label = `${product.color} hoodie on a male model, ${view} view`;
---

<svg class="model-art" viewBox="0 0 360 420" role="img" aria-label={label} xmlns="http://www.w3.org/2000/svg">
	<defs>
		<linearGradient id={`model-fabric-${product.slug}`} x1="0" x2="1" y1="0" y2="1">
			<stop stop-color={product.highlightHex} />
			<stop offset=".52" stop-color={product.colorHex} />
			<stop offset="1" stop-color={product.shadowHex} />
		</linearGradient>
		<linearGradient id={`model-sleeve-${product.slug}`} x1="0" x2="1" y1="0" y2="0">
			<stop stop-color={product.colorHex} />
			<stop offset="1" stop-color={product.shadowHex} />
		</linearGradient>
	</defs>
	<ellipse cx="180" cy="391" rx="91" ry="12" fill="#60567a" opacity=".12" />
	{view === "side" ? (
		<g stroke="#534961" stroke-linejoin="round" stroke-width="2">
			<path d="m160 297 49 1-3 49 34 39h-47l-31-48-16 46h-40l39-52z" fill="#72758c" />
			<path d="M153 75c-7-27 4-47 27-48 21 3 28 20 24 40l-10 29-34-4z" fill="#b97859" />
			<path d="M146 68c-3-31 13-49 37-45 19 2 28 14 29 32l-13-8-7-13-10 12-29 12z" fill="#42342f" />
			<path d="m172 88-5 24 24 11 8-29z" fill="#b97859" />
			<path d="M157 111q18-12 42 2l27 27-18 166-76-3 15-143-21 4-28 107-31-10 23-117q5-22 26-28z" fill={`url(#model-fabric-${product.slug})`} />
			<path d="M153 119q24 7 42 0l-3 36-32 7-14-26z" fill={product.shadowHex} />
			<path d="m130 143-24 13-20 87 28 8 25-64zM222 143l16 16-8 76-25 4-1-63z" fill={`url(#model-sleeve-${product.slug})`} />
			<path d="m113 239 22 5-4 18-22-5zM209 231l24 2-1 18-23-1z" fill={product.shadowHex} />
			<path d="M173 182q25 12 41 4l-2 42q-20 9-44-2z" fill={product.shadowHex} />
			<path d="M167 111q12 11 28 4" fill="none" stroke="#fff" opacity=".55" />
			<path d="M165 116v16m13-13v17" fill="none" stroke={product.trimHex} stroke-linecap="round" />
			<text x="190" y="214" fill={product.highlightHex} font-size="7" font-weight="700" letter-spacing="1" text-anchor="middle">{product.mark}</text>
		</g>
	) : (
		<g stroke="#534961" stroke-linejoin="round" stroke-width="2">
			<path d="m112 300 137 1 4 43-34 46h-47l15-46-13-44-18 44 14 46h-49l-20-45z" fill="#72758c" />
			{view === "back" ? (
				<>
					<path d="M143 75c-4-29 11-48 37-49 26 1 41 20 37 49l-18 34h-38z" fill="#42342f" />
					<path d="M126 91q12-24 54-22 41-2 54 22l-5 35h-98z" fill={product.shadowHex} />
				</>
			) : (
				<>
					<path d="M144 70c-4-27 8-44 36-45 27 1 40 19 36 46l-5 27h-61z" fill="#42342f" />
					<path d="M149 66q31-18 62 0l-4 28q-4 26-27 27-23-1-27-27z" fill="#bd8665" />
					<path d="M146 66q1-35 35-41 34 4 39 34l-15-9-9-13-13 12-35 13z" fill="#42342f" />
					<path d="M162 78h8m20 0h8" stroke="#493a36" stroke-linecap="round" />
					<path d="M173 100q9 5 17 0" fill="none" stroke="#8c5148" stroke-linecap="round" />
				</>
			)}
			<path d="m166 105-3 20 34 0-3-20z" fill="#bd8665" />
			<path d="M128 119q18-17 39-17l14 18 14-18q22 0 39 17l-3 190H130z" fill={`url(#model-fabric-${product.slug})`} />
			<path d="m129 120-22 8q-13 5-18 23l-26 114q-4 17 11 22l17 5 47-105z" fill={`url(#model-sleeve-${product.slug})`} />
			<path d="m237 120 22 8q13 5 18 23l26 114q4 17-11 22l-17 5-47-105z" fill={`url(#model-sleeve-${product.slug})`} />
			<path d="m64 264 29 8-5 19q-17 6-29-4zM267 272l29-8 5 23q-12 10-29 4z" fill={product.shadowHex} />
			<path d="M132 301q48 10 96 0v18H132z" fill={product.shadowHex} />
			{view === "back" ? (
				<>
					<path d="M137 128q43 14 86 0M151 176q29 17 58 0" fill="none" stroke={product.shadowHex} stroke-width="3" />
					<text x="180" y="204" fill={product.trimHex} font-size="8" font-weight="700" letter-spacing="1.2" text-anchor="middle">{product.mark}</text>
				</>
			) : (
				<>
					<path d="M180 123v108" fill="none" stroke="#fff" opacity=".45" />
					<path d="M140 230q40 15 80 0l-5 45q-35 16-70 0z" fill={product.shadowHex} stroke-width="1.5" />
					<path d="M163 105q17 13 34 0" fill="none" stroke={product.trimHex} stroke-linecap="round" stroke-width="2.5" />
					<path d="M159 118v42m42-42v42" fill="none" stroke={product.trimHex} stroke-linecap="round" stroke-width="2" />
					<path d="M168 151q12-12 24 0-12 13-24 0z" fill={product.trimHex} stroke="none" />
					<text x="180" y="154" fill={product.highlightHex} font-size="5.5" font-weight="700" letter-spacing=".7" text-anchor="middle">{product.mark}</text>
				</>
			)}
		</g>
	)}
</svg>

<style>
	.model-art {
		display: block;
		width: 100%;
		height: 100%;
	}
</style>
