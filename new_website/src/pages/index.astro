---
import { products } from "../data/products.js";
import HoodieArt from "../components/HoodieArt.astro";

const closetOrder = [
	"grape-escape",
	"pink-sundae",
	"cherry-on-top",
	"blue-hour",
	"sunday-club",
	"lemon-drop",
	"after-hours",
	"cloud-nine",
];
const closetProducts = [...products].sort((a, b) => closetOrder.indexOf(a.slug) - closetOrder.indexOf(b.slug));
const heroProduct = products.find((product) => product.slug === "grape-escape");
const base = `${import.meta.env.BASE_URL}/`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content="Meet Comfy: hoodies for slow mornings, late nights, and everything in between." />
		<meta name="theme-color" content="#f7f5ff" />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<title>Comfy — Pick your new favorite hoodie</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<style>
			:root {
				font-family: "DM Sans", sans-serif;
				color: #34304d;
				background: #f7f5ff;
				font-synthesis: none;
				text-rendering: optimizeLegibility;
				--ink: #34304d;
				--muted: #77728b;
				--paper: #f7f5ff;
				--purple: #b9a3e6;
				--cyan: #b5e7e4;
				--blue: #b9d1f4;
				--yellow: #f0df9e;
				--line: #e4def1;
				--display: "Space Grotesk", sans-serif;
			}
			* { box-sizing: border-box; }
			html { scroll-behavior: smooth; }
			body { margin: 0; min-width: 320px; overflow-x: hidden; }
			button, a { color: inherit; font: inherit; }
			a { text-decoration: none; }
			button { cursor: pointer; }
			.announcement {
				padding: 10px 20px;
				background: var(--ink);
				color: white;
				text-align: center;
				font-size: 10px;
				font-weight: 600;
				letter-spacing: .13em;
				text-transform: uppercase;
			}
			.announcement span { color: var(--yellow); }
			header {
				height: 76px;
				padding: 0 7%;
				display: flex;
				align-items: center;
				justify-content: space-between;
				border-bottom: 1px solid var(--line);
			}
			.brand {
				font-family: var(--display);
				font-size: 28px;
				font-weight: 700;
				letter-spacing: -.09em;
			}
			.brand i { color: #967fc7; font-style: normal; }
			nav { display: flex; align-items: center; gap: 30px; }
			nav a { font-size: 12px; font-weight: 600; }
			nav a:hover { color: #806bb1; }
			.cart {
				padding: 10px 15px;
				border: 1px solid var(--ink);
				border-radius: 30px;
				background: transparent;
				font-size: 11px;
				font-weight: 700;
			}
			.cart span { margin-left: 7px; color: #806bb1; }
			.hero {
				min-height: 580px;
				position: relative;
				display: grid;
				grid-template-columns: 1fr 1fr;
				align-items: center;
				overflow: hidden;
				padding: 70px 10%;
			}
			.hero::before, .hero::after {
				content: "";
				position: absolute;
				z-index: -1;
				border-radius: 50%;
				filter: blur(1px);
			}
			.hero::before {
				width: 400px;
				height: 400px;
				right: 9%;
				top: 12%;
				background: #e5e0f6;
			}
			.hero::after {
				width: 170px;
				height: 170px;
				right: 8%;
				bottom: 3%;
				background: #e0f2f1;
			}
			.hero-copy { position: relative; z-index: 1; }
			.eyebrow {
				display: flex;
				align-items: center;
				gap: 9px;
				font-size: 10px;
				font-weight: 700;
				letter-spacing: .16em;
				text-transform: uppercase;
			}
			.eyebrow::before { content: ""; width: 22px; height: 1px; background: currentColor; }
			h1, h2, p { margin-top: 0; }
			h1 {
				margin: 16px 0 10px;
				font-family: var(--display);
				font-size: clamp(88px, 13vw, 174px);
				font-weight: 600;
				letter-spacing: -.105em;
				line-height: .8;
			}
			h1 span { color: #8e78bf; }
			.hero-copy > p {
				margin: 23px 0 28px;
				color: #726d84;
				font-size: 14px;
				line-height: 1.7;
			}
			.hero-cta {
				display: inline-flex;
				align-items: center;
				gap: 28px;
				padding: 15px 19px;
				border: 1px solid var(--ink);
				border-radius: 3px;
				background: var(--ink);
				color: white;
				font-size: 10px;
				font-weight: 700;
				letter-spacing: .1em;
				text-transform: uppercase;
				transition: transform 160ms ease, background 160ms ease;
			}
			.hero-cta:hover { transform: translateY(-3px); background: #51466f; }
			.hero-cta b { color: var(--yellow); font-size: 17px; font-weight: 400; }
			.hero-art {
				height: 400px;
				position: relative;
				display: grid;
				place-items: center;
			}
			.hero-photo {
				position: relative;
				z-index: 1;
				display: block;
				width: min(100%, 360px);
				height: 100%;
				filter: drop-shadow(0 22px 18px #51466f2b);
				transform: rotate(2deg) scale(1.15);
			}
			.hero-sticker {
				position: absolute;
				right: 3%;
				bottom: 6%;
				display: grid;
				width: 94px;
				height: 94px;
				place-items: center;
				border: 1px solid #fff9;
				border-radius: 50%;
				background: var(--yellow);
				font-family: var(--display);
				font-size: 11px;
				font-weight: 700;
				line-height: 1.2;
				text-align: center;
				transform: rotate(9deg);
			}
			.collection {
				padding: 77px 0 89px;
				background: #eeebf9;
				overflow: hidden;
			}
			.collection-heading {
				padding: 0 7%;
				display: flex;
				align-items: flex-end;
				justify-content: space-between;
				gap: 20px;
			}
			.collection-heading h2 {
				margin: 12px 0 0;
				font-family: var(--display);
				font-size: clamp(34px, 5vw, 58px);
				font-weight: 500;
				letter-spacing: -.07em;
				line-height: 1;
			}
			.collection-heading p {
				max-width: 230px;
				margin: 0;
				color: var(--muted);
				font-size: 12px;
				line-height: 1.6;
			}
			.rail-controls { display: flex; gap: 8px; margin-top: 24px; padding: 0 7%; }
			.rail-controls button {
				width: 39px;
				height: 39px;
				border: 1px solid #cfc7df;
				border-radius: 50%;
				background: transparent;
				font-size: 17px;
			}
			.rail-controls button:hover { background: white; }
			.wardrobe {
				position: relative;
				margin: 26px 7% 0;
				padding: 26px 0 18px;
				perspective: 1400px;
				background: linear-gradient(90deg, #aebfe0, #dce5f6 5%, #e7eafa 95%, #aebfe0);
				border: 8px solid #c7d4ee;
				box-shadow: 0 22px 40px #47426718, inset 0 0 0 2px #f7f5ff;
			}
			.wardrobe-interior {
				position: absolute;
				inset: 0;
				overflow: hidden;
				background:
					linear-gradient(90deg, #c4d2ec 0, transparent 7%, transparent 93%, #c4d2ec 100%),
					linear-gradient(180deg, #dce5f6, #f4f2fb 52%, #d7e8ee);
			}
			.wardrobe-interior::before, .wardrobe-interior::after {
				content: "";
				position: absolute;
				left: 0;
				right: 0;
				height: 12px;
				background: linear-gradient(#f7f5ff, #b9c9e6);
				box-shadow: 0 5px 8px #47426718;
			}
			.wardrobe-interior::before { top: 0; }
			.wardrobe-interior::after { bottom: 0; }
			.wardrobe-label {
				position: absolute;
				top: 12px;
				left: 50%;
				z-index: 1;
				padding: 7px 12px;
				transform: translateX(-50%);
				border-radius: 2px;
				background: #f7f5ffed;
				color: #716c85;
				font-size: 8px;
				font-weight: 700;
				letter-spacing: .16em;
				text-transform: uppercase;
			}
			.hanger-window {
				position: relative;
				z-index: 1;
				margin-top: 10px;
				padding: 0 22px;
			}
			.hanger-window::before {
				content: "";
				position: absolute;
				top: 35px;
				right: 22px;
				left: 22px;
				height: 7px;
				border: 1px solid #9faecb;
				border-radius: 10px;
				background: linear-gradient(180deg, #fff, #aebcda);
				box-shadow: 0 5px 10px #51466f2b;
			}
			.hanger-rail {
				position: relative;
				display: flex;
				align-items: flex-start;
				gap: 15px;
				overflow-x: auto;
				padding: 0 8px 24px;
				scroll-snap-type: x mandatory;
				scroll-padding-inline: calc((100% - 190px) / 2);
				scrollbar-width: thin;
				scrollbar-color: #b6a4df transparent;
			}
			.hanger-rail::-webkit-scrollbar { height: 6px; }
			.hanger-rail::-webkit-scrollbar-thumb { border-radius: 10px; background: #b6a4df; }
			.product-card {
				flex: 0 0 190px;
				position: relative;
				padding-top: 43px;
				scroll-snap-align: center;
				transform: translateY(13px) scale(.82) rotateY(-31deg);
				transform-origin: center top;
				opacity: .76;
				transition: transform 520ms cubic-bezier(.2,.8,.2,1), opacity 380ms ease;
			}
			.product-card.is-focused { transform: translateY(-13px) scale(1.13) rotateY(0); opacity: 1; z-index: 2; }
			.hanger {
				position: absolute;
				top: 8px;
				left: 50%;
				z-index: 2;
				width: 56px;
				height: 38px;
				transform: translateX(-50%);
				filter: drop-shadow(0 3px 2px #51466f35);
			}
			.hanger::before {
				content: "";
				position: absolute;
				top: -7px;
				left: 24px;
				width: 10px;
				height: 15px;
				border: 2px solid #8c82ad;
				border-bottom: 0;
				border-radius: 9px 9px 2px 2px;
			}
			.hanger::after {
				content: "";
				position: absolute;
				top: 5px;
				left: 0;
				width: 54px;
				height: 31px;
				background: linear-gradient(165deg, transparent 46%, #8c82ad 48%, #8c82ad 52%, transparent 54%) left,
					linear-gradient(195deg, transparent 46%, #8c82ad 48%, #8c82ad 52%, transparent 54%) right;
				background-size: 50% 100%;
				background-repeat: no-repeat;
			}
			.garment {
				position: relative;
				width: 100%;
				height: 250px;
				overflow: visible;
				filter: drop-shadow(0 11px 9px #51466f25);
				transition: filter 300ms ease, transform 400ms ease;
				transform: perspective(800px) rotateY(-8deg);
				background: transparent;
			}
			.is-focused .garment {
				transform: perspective(800px) rotateY(0) translateY(-11px) scale(1.08);
				filter: drop-shadow(0 19px 15px #51466f32);
			}
			.garment img {
				width: 100%;
				height: 100%;
				object-fit: contain;
				object-position: center;
			}
			.closet-doors {
				position: absolute;
				inset: 0;
				z-index: 4;
				display: grid;
				grid-template-columns: 1fr 1fr;
				perspective: 1400px;
				width: 100%;
				height: 100%;
				padding: 0;
				border: 0;
				background: transparent;
				cursor: pointer;
			}
			.closet-doors:focus-visible { outline: 3px solid #806bb1; outline-offset: -5px; }
			.door {
				position: relative;
				border: 1px solid #aebcda;
				background:
					linear-gradient(90deg, #fff6, transparent 10%, transparent 88%, #55507b21),
					linear-gradient(135deg, #e4e0f5, #c9d4ee 48%, #ebe9f8);
				box-shadow: inset 0 0 0 8px #dce4f6, inset 0 0 0 10px #b8c5e1;
				backface-visibility: hidden;
				transition: transform 1250ms cubic-bezier(.2,.75,.2,1);
			}
			.door-left {
				transform-origin: left center;
			}
			.door-right {
				transform-origin: right center;
			}
			.wardrobe.is-open .door-left { transform: rotateY(-108deg); }
			.wardrobe.is-open .door-right { transform: rotateY(108deg); }
			.door::before {
				content: "";
				position: absolute;
				top: 50%;
				width: 7px;
				height: 38px;
				margin-top: -19px;
				border-radius: 5px;
				background: linear-gradient(90deg, #8b83b2, #d7d4ed, #8279a8);
				box-shadow: 1px 2px 4px #453c6b40;
			}
			.door-left::before { right: 16px; }
			.door-right::before { left: 16px; }
			.door-label {
				position: absolute;
				top: 50%;
				left: 50%;
				color: #625a87;
				font-family: var(--display);
				font-size: clamp(16px, 3vw, 30px);
				font-weight: 600;
				letter-spacing: -.06em;
				transform: translate(-50%, -50%);
				white-space: nowrap;
				transition: opacity 250ms ease;
			}
			.wardrobe.is-open .door-label { opacity: 0; }
			.badge {
				position: absolute;
				top: 12px;
				left: 12px;
				z-index: 2;
				padding: 8px 10px;
				background: var(--paper);
				font-size: 8px;
				font-weight: 700;
				letter-spacing: .1em;
			}
			.product-caption {
				display: flex;
				align-items: flex-start;
				justify-content: space-between;
				gap: 10px;
				padding: 14px 2px;
			}
			.product-caption h3 { margin: 0 0 5px; font-size: 13px; font-weight: 700; }
			.product-caption p { margin: 0; color: var(--muted); font-size: 10px; }
			.product-caption strong { font-size: 12px; }
			.product-link { display: block; outline-offset: 5px; }
			.product-link:focus-visible { outline: 2px solid #8266ae; }
			.scroll-hint {
				padding: 8px 7% 0;
				color: #77728b;
				font-size: 9px;
				font-weight: 700;
				letter-spacing: .12em;
				text-align: right;
				text-transform: uppercase;
			}
			.slogan {
				padding: 82px 20px 77px;
				background: #e2eafa;
				text-align: center;
			}
			.slogan blockquote {
				max-width: 760px;
				margin: 0 auto;
				font-family: var(--display);
				font-size: clamp(30px, 5vw, 57px);
				letter-spacing: -.065em;
				line-height: 1.12;
			}
			.slogan blockquote span { color: #806bb1; }
			.slogan p {
				margin: 22px 0 0;
				font-size: 10px;
				font-weight: 700;
				letter-spacing: .13em;
			}
			footer {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 20px;
				padding: 25px 7%;
				background: var(--ink);
				color: white;
				font-size: 10px;
			}
			footer .brand { font-size: 23px; }
			footer p { margin: 0; color: #e2def1; }
			footer .disclaimer { max-width: 430px; color: var(--yellow); font-size: 9px; font-weight: 700; line-height: 1.5; letter-spacing: .06em; }
			.toast {
				position: fixed;
				right: 20px;
				bottom: 20px;
				z-index: 5;
				padding: 14px 18px;
				transform: translateY(16px);
				opacity: 0;
				background: var(--ink);
				color: white;
				font-size: 12px;
				pointer-events: none;
				transition: 180ms ease;
			}
			.toast.show { transform: translateY(0); opacity: 1; }
			.hanger-window {
				visibility: hidden;
				opacity: 0;
				transform: translateY(12px);
				transition: opacity 400ms ease, transform 400ms ease, visibility 0s linear 400ms;
			}
			.wardrobe.is-open .hanger-window {
				visibility: visible;
				opacity: 1;
				transform: translateY(0);
				transition-delay: 300ms, 300ms, 0s;
			}
			.wardrobe.is-open .closet-doors { pointer-events: none; }
			.rail-controls, .scroll-hint {
				visibility: hidden;
				opacity: 0;
				transition: opacity 300ms ease, visibility 0s linear 300ms;
			}
			.collection.is-open .rail-controls, .collection.is-open .scroll-hint {
				visibility: visible;
				opacity: 1;
				transition-delay: 0s;
			}
			@media (prefers-reduced-motion: reduce) {
				.hanger-window, .door, .door-label { transition-duration: .01ms; }
			}
			@media (max-width: 700px) {
				header { height: 66px; padding-inline: 20px; }
				nav { gap: 14px; }
				nav a { display: none; }
				.hero {
					min-height: 0;
					grid-template-columns: 1fr;
					padding: 63px 25px 25px;
				}
				h1 { font-size: clamp(100px, 28vw, 156px); }
				.hero-copy > p { font-size: 12px; }
				.hero-art { height: 300px; margin-top: 20px; }
				.hero-photo { width: min(100%, 300px); }
				.hero::before { width: 270px; height: 270px; top: auto; right: 12%; bottom: 8%; }
				.hero-sticker { right: 3%; bottom: 3%; width: 77px; height: 77px; font-size: 9px; }
				.collection { padding-top: 58px; }
				.collection-heading { align-items: flex-start; flex-direction: column; padding-inline: 22px; }
				.collection-heading h2 { font-size: 38px; }
				.collection-heading p { max-width: 280px; }
				.rail-controls { padding-inline: 22px; }
				.wardrobe { margin: 22px 10px 0; border-width: 6px; padding-block: 20px 14px; }
				.wardrobe-label { top: 8px; }
				.hanger-window { padding-inline: 11px; }
				.hanger-window::before { right: 11px; left: 11px; }
				.product-card { flex-basis: min(49vw, 205px); scroll-margin-inline: 10px; }
				.garment { height: min(64vw, 252px); }
				.hanger-rail { gap: 8px; scroll-padding-inline: 18vw; }
				.scroll-hint { padding-right: 22px; }
				.slogan { padding: 63px 24px; }
				footer { align-items: flex-start; flex-direction: column; padding: 24px 22px; }
			}
			@media (prefers-reduced-motion: reduce) {
				*, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; }
			}
		</style>
	</head>
	<body>
		<div class="announcement">THIS IS NOT A REAL BUSINESS, IT IS A MOCK-UP CREATED FOR DEMONSTRATION PURPOSES ONLY</div>
		<header>
			<a class="brand" href={base} aria-label="Comfy home">Comfy<span>®</span></a>
			<nav aria-label="Main navigation">
				<a href="#collection">The hoodies</a>
				<a href="#our-thing">Our thing</a>
				<button class="cart" type="button" aria-label="Shopping bag, 0 items">BAG <span id="cart-count">0</span></button>
			</nav>
		</header>

		<main>
			<section class="hero" aria-labelledby="hero-title">
				<div class="hero-copy">
					<div class="eyebrow">Good days start here</div>
					<h1 id="hero-title">Com<span>fy</span></h1>
					<p>Your soft place to land.<br />Meet the hoodie you won't want to take off.</p>
					<a class="hero-cta" href="#collection">Click the hoodie you like <b>↓</b></a>
				</div>
				<div class="hero-art">
					<div class="hero-photo"><HoodieArt product={heroProduct} view="front" /></div>
					<div class="hero-sticker">SOFT<br />LOOKS GOOD<br />ON YOU ✳</div>
				</div>
			</section>

			<section class="collection" id="collection" aria-labelledby="collection-title">
				<div class="collection-heading">
					<div>
						<div class="eyebrow">Meet your new regulars</div>
						<h2 id="collection-title">Pick your kind of cozy.</h2>
					</div>
					<p>Eight pastel shades, waiting together on one hanger. Click the cupboard to choose your mood.</p>
				</div>
				<div class="rail-controls" aria-label="Hoodie collection controls">
					<button type="button" id="rail-prev" aria-label="Scroll to previous hoodie">←</button>
					<button type="button" id="rail-next" aria-label="Scroll to next hoodie">→</button>
				</div>
				<div class="wardrobe" id="wardrobe">
					<div class="wardrobe-interior" aria-hidden="true"></div>
					<div class="wardrobe-label" aria-hidden="true">YOUR COZY COLLECTION</div>
					<div class="hanger-window">
						<div class="hanger-rail" id="hanger-rail" tabindex="0" aria-label="Scroll through eight hoodies" aria-hidden="true" inert>
						{closetProducts.map((product) => (
							<article class="product-card">
								<a class="product-link" href={`${base}hoodies/${product.slug}/`} aria-label={`View ${product.name} hoodie`}>
									<div class="hanger" aria-hidden="true"></div>
									<div class="garment">
										<HoodieArt product={product} view="front" />
										{product.badge && <span class="badge">{product.badge}</span>}
									</div>
									<div class="product-caption">
										<div>
											<h3>{product.name}</h3>
											<p>{product.color}</p>
										</div>
										<strong>${product.price}</strong>
									</div>
								</a>
							</article>
						))}
						</div>
					</div>
					<button class="closet-doors" type="button" aria-label="Open the cupboard to choose your mood" aria-expanded="false" aria-controls="hanger-rail">
						<div class="door door-left"></div>
						<div class="door door-right"></div>
						<span class="door-label">choose your mood</span>
					</button>
				</div>
				<div class="scroll-hint">Swipe or scroll to explore all 8 ↔</div>
			</section>

			<section class="slogan" id="our-thing">
				<blockquote>Not just a hoodie. Your new <span>“cancel plans, stay in”</span> hoodie.</blockquote>
				<p>Goodform — comfort looks good on you</p>
			</section>
		</main>
		<footer>
			<a class="brand" href={base} aria-label="Comfy home">Comfy<span>®</span></a>
			<p>Wear it on repeat. Feel good doing it.</p>
			<p>© 2025 COMFY STUDIO</p>
			<p class="disclaimer">THIS IS NOT A REAL BUSINESS, IT IS A MOCK-UP CREATED FOR DEMONSTRATION PURPOSES ONLY</p>
		</footer>
		<div class="toast" id="toast" role="status" aria-live="polite"></div>
		<script>
			const rail = document.querySelector("#hanger-rail");
			const cards = [...document.querySelectorAll(".product-card")];
			const cartCount = document.querySelector("#cart-count");
			const cartButton = document.querySelector(".cart");
			const storedCount = Number(localStorage.getItem("comfy-cart-count") || 0);
			cartCount.textContent = String(storedCount);
			cartButton.setAttribute("aria-label", `Shopping bag, ${storedCount} items`);
			const wardrobe = document.querySelector("#wardrobe");
			const collection = document.querySelector("#collection");
			const closetDoors = document.querySelector(".closet-doors");
			closetDoors.addEventListener("click", () => {
				wardrobe.classList.add("is-open");
				collection.classList.add("is-open");
				closetDoors.setAttribute("aria-expanded", "true");
				closetDoors.setAttribute("aria-label", "Cupboard open; choose your mood from the hoodie rail");
				closetDoors.tabIndex = -1;
				rail.removeAttribute("inert");
				rail.setAttribute("aria-hidden", "false");
			}, { once: true });

			const updateFocusedCard = () => {
				const railBounds = rail.getBoundingClientRect();
				const center = railBounds.left + railBounds.width / 2;
				let closestCard;
				let closestDistance = Infinity;
				cards.forEach((card) => {
					const bounds = card.getBoundingClientRect();
					const distance = Math.abs(bounds.left + bounds.width / 2 - center);
					if (distance < closestDistance) {
						closestDistance = distance;
						closestCard = card;
					}
				});
				cards.forEach((card) => card.classList.toggle("is-focused", card === closestCard));
			};
			rail.addEventListener("scroll", updateFocusedCard, { passive: true });
			window.addEventListener("resize", updateFocusedCard);
			updateFocusedCard();

			const scrollByCard = (direction) => {
				const focusedIndex = Math.max(0, cards.findIndex((card) => card.classList.contains("is-focused")));
				const target = cards[Math.max(0, Math.min(cards.length - 1, focusedIndex + direction))];
				target?.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "center" });
			};
			document.querySelector("#rail-prev").addEventListener("click", () => scrollByCard(-1));
			document.querySelector("#rail-next").addEventListener("click", () => scrollByCard(1));
		</script>
	</body>
</html>
